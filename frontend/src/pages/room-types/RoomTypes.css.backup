.room-types-root { max-width: 1080px; margin: 0 auto; padding: 16px; }.room-types-header, .room-types-actions { display: flex; align-items: center; gap: 10px; }.room-types-header { justify-content: space-between; margin-bottom: 22px; }.room-types-header h1 { margin: 8px 0 4px; font-size: 1.8rem; }.room-types-header p { margin: 0; color: var(--text); }.room-types-loading, .room-types-empty, .room-types-error { margin: 12px 0; padding: 14px; border-radius: 8px; }.room-types-loading, .room-types-empty { color: var(--text); background: #fff; border: 1px solid var(--border); }.room-types-error { color: #8c2424; background: #fff1f1; border: 1px solid #eabbbb; }.room-types-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 9px; background: #fff; }.room-types-table { width: 100%; border-collapse: collapse; }.room-types-table th, .room-types-table td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); }.room-types-table th { color: var(--text); font-size: .76rem; text-transform: uppercase; }.room-types-table tr[role="button"] { cursor: pointer; }.room-types-table tr[role="button"]:hover { background: #f5f9f5; }.room-type-form { max-width: 600px; display: grid; gap: 14px; padding: 20px; border: 1px solid var(--border); border-radius: 9px; background: #fff; }.room-type-form label { display: grid; gap: 5px; color: var(--text); font-size: .86rem; font-weight: 600; }.room-type-form input, .room-type-form textarea { padding: 9px; color: var(--text-h); border: 1px solid #ccd8ce; border-radius: 6px; background: #fff; }.room-type-form textarea { min-height: 90px; resize: vertical; }.room-type-form .checkbox-label { display: flex; align-items: center; gap: 8px; }.room-type-form .checkbox-label input { width: auto; }.room-type-form .btn { justify-self: start; }.room-type-detail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }.room-type-detail > div { display: grid; gap: 6px; padding: 15px; border: 1px solid var(--border); border-radius: 8px; background: #fff; }.room-type-detail span { color: var(--text); font-size: .76rem; text-transform: uppercase; }.room-type-detail strong { overflow-wrap: anywhere; } @media (max-width: 650px) { .room-types-header { align-items: flex-start; flex-direction: column; }.room-types-table thead { display: none; }.room-types-table, .room-types-table tbody, .room-types-table tr, .room-types-table td { display: block; }.room-types-table tr { padding: 8px; border-bottom: 1px solid var(--border); }.room-types-table td { display: flex; justify-content: space-between; border: 0; }.room-types-table td::before { content: attr(data-label); color: var(--text); font-size: .76rem; font-weight: 700; }.room-type-detail { grid-template-columns: 1fr; } }
